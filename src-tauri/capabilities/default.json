{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Full App alignment capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-ping",
    "allow-ensure-default-library",
    "allow-get-snapshot",
    "allow-withdraw",
    "allow-read-library-text",
    "allow-save-library-file",
    "allow-pick-folder",
    "allow-open-path",
    "allow-reveal-in-folder",
    "allow-choose-library-root",
    "allow-ui-state",
    "allow-open-entry-side",
    "allow-deploy-withdraw",
    "allow-scan-ingest",
    "allow-projects-purpose",
    "allow-refresh",
    "allow-backup-dual",
    "allow-resolve-drag-paths",
    "allow-catalog-settings",
    "allow-network-library",
    "drag:default"
  ]
}
