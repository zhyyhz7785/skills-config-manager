{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCM-Tauri2",
  "version": "0.1.0",
  "identifier": "local.ccm.tauri2",
  "build": {
    "beforeDevCommand": "npm run dev:tauri-frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCM-Tauri2",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
